# ─── Server-only secrets (never sent to the browser; used in app/api/* only) ───
# EVM token balances (Alchemy). Required for EVM discovery.
ALCHEMY_API_KEY=
# Solana balances (Helius). If unset, falls back to the public RPC below / mainnet-beta.
HELIUS_API_KEY=
SOLANA_RPC=
# Token USD prices (CoinGecko demo key, optional — improves rate limits).
COINGECKO_API_KEY=

# ─── Client-exposed (NEXT_PUBLIC_*) ───
# Your fee-recipient address on the Sonic hub (EVM). Where partner fees accrue.
NEXT_PUBLIC_PARTNER_SONIC_ADDRESS=0x0000000000000000000000000000000000000000
# WalletConnect project id (adds the WalletConnect connector for EVM).
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional RPC overrides (public defaults are used if unset).
NEXT_PUBLIC_SONIC_RPC=
NEXT_PUBLIC_ETH_RPC=
NEXT_PUBLIC_BASE_RPC=
NEXT_PUBLIC_ARB_RPC=
NEXT_PUBLIC_OP_RPC=
NEXT_PUBLIC_POLYGON_RPC=
NEXT_PUBLIC_BSC_RPC=
NEXT_PUBLIC_AVAX_RPC=
